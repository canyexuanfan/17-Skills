#!/usr/bin/env bash
# rweb — reddit.com CLI launcher (guest / logged-in).
#
#   ./bin/rweb caps
#   ./bin/rweb json /r/programming/hot --limit 100
#   ./bin/rweb login --cookie "token_v2=...; reddit_session=..."
#
# There is no default subcommand in this CLI: every invocation names its own
# subcommand, so the launcher does not need to inject one. It does verify that
# the CLI is loadable first, so a broken install fails loudly here instead of
# halfway through a request.
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
CLI="$REPO/rweb/cli.py"
PY="${RWEB_PY:-python3}"

if [ ! -f "$CLI" ]; then
  echo "[rweb] cannot find $CLI —— run ./install.sh from the repo root, or: pipx install ." >&2
  exit 2
fi

if ! "$PY" -c "import sys; sys.path.insert(0, '$REPO'); import rweb" 2>/dev/null; then
  echo "[rweb] package failed to import —— check that the repo is complete" >&2
  exit 2
fi

exec "$PY" "$CLI" "$@"
